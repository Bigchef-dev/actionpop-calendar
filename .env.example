# Shared environment defaults.
# Copy to `.env` for native runs and keep machine-specific values in `.env.local`
# (loaded last, never committed).

# Docker-internal values used by infra/compose/docker-compose.yml.
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://actionpop:actionpop@postgres:5432/actionpop
UPSTREAM_BASE_URL=https://actionpopulaire.example

# For `pnpm dev`, override hostnames in `.env.local` instead:
#   REDIS_URL=redis://127.0.0.1:6379
#   DATABASE_URL=postgresql://actionpop:actionpop@127.0.0.1:5432/actionpop
#   NODE_ENV=development

NODE_ENV=production
TIMEZONE=Europe/Paris
PORT=3000
# Map discovery is enabled by default; override in the deployment when needed.
INGESTION_MAP_DISCOVERY_ENABLED=true
INGESTION_MAP_FRESHNESS_HORIZON_MS=3600000
INGESTION_MAP_RECONCILIATION_INTERVAL_MS=604800000
