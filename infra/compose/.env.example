# Runtime images. `publish-images.yml` publishes them on every push to `main`, each build under
# its commit SHA and under `latest`; uncomment a line to pin the build you validated. Left out,
# Compose uses the same references as defaults.
# API_IMAGE=ghcr.io/bigchef-dev/actionpop-api:latest
# WEB_IMAGE=ghcr.io/bigchef-dev/actionpop-web:latest
# WORKER_IMAGE=ghcr.io/bigchef-dev/actionpop-worker:latest
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://actionpop:actionpop@postgres:5432/actionpop
POSTGRES_DB=actionpop
POSTGRES_USER=actionpop
# POSTGRES_PASSWORD=provided-by-deployment-secret-store
NODE_ENV=production
TIMEZONE=Europe/Paris
PORT=3000
UPSTREAM_BASE_URL=https://actionpopulaire.example
# UPSTREAM_TOKEN=provided-by-deployment-secret-store
# Proxy the worker reaches the source through. Environment-only, usually credential-bearing.
# Accepts socks5://, socks://, http:// and https://; leave unset for a direct connection.
# SOCK_PROXY=socks5://proxy-host:1080
# Short identifier of this instance, emitted as the `deployment` metric label (a-z0-9_- , max 32).
# Set it when two instances run at once, for example during a cutover.
OBSERVABILITY_DEPLOYMENT=production
# Secret used to re-key the daily client volume band. Environment-only: never commit a value.
OBSERVABILITY_BAND_SALT=provided-by-deployment-secret-store
# TELEMETRY_ENABLED — whether the published site may report journey steps (true/false)
TELEMETRY_ENABLED=true
# MONITORING_NETWORK — existing Docker network shared with Prometheus and Grafana
MONITORING_NETWORK=monitoring
# API_REFERENCE — exposes /reference and /openapi.json; leave false in production
API_REFERENCE=false
