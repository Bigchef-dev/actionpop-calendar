    {
      "type": "row",
      "title": "Filters",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Filter cardinality",
      "datasource": {
        "type": "prometheus",
        "uid": "actionpop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
