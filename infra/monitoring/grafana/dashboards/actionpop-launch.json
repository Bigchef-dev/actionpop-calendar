      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (subject_kind) (increase(actionpop_calendar_requests_total{delivery=\"first\",client_kind=\"agenda\"}[$__range])) or vector(0)",
          "legendFormat": "new {{subject_kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "actionpop-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (subject_kind) (increase(actionpop_calendar_requests_total{delivery=\"revalidated\",client_kind=\"agenda\"}[$__range])) or vector(0)",
          "legendFormat": "renewed {{subject_kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "actionpop-prometheus"
          }
        }
