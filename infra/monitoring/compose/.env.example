# Copy to `.env` next to this file; Compose reads it automatically.
# Credentials and endpoints only. Nothing here is ever committed with a value.

# Host ports, bound to 127.0.0.1. Change them when something else already listens.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# How long Prometheus keeps samples. Fifteen days covers a monthly launch review.
PROMETHEUS_RETENTION=15d

# The name of the shared network. It must match MONITORING_NETWORK in the application `.env`,
# because that is the only thing linking the two Compose projects.
MONITORING_NETWORK=monitoring

# Grafana account. Change the password: the fallback in docker-compose.yml is a placeholder, and
# Grafana refuses to start with its own built-in default.
#
# Read once, at initialisation: editing this value later does not change an existing account. Take
# effect by recreating the database (`docker compose down -v` deletes every hand-made dashboard
# too) or by resetting the password with `grafana cli admin reset-admin-password`.
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=provided-by-deployment-secret-store
