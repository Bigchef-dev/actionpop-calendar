erDiagram
    direction TB


    PROCESSING_PERIOD {
        string period_token PK "UTC slot identity"
        datetime period_start_utc
        datetime period_end_utc
    }

    INGESTION_LEDGER {
        string ledger_key PK "technical processing identity"
        string job_id FK
        string status "scheduled running publishing succeeded retrying failed"
        datetime last_completed_at
    }

    INGESTION_JOB {
        string job_id PK "deterministic scope-period id"
        string scope_id FK
        string scope_kind "group | event, chooses the processor"
        string period_token FK
        string status "waiting delayed active completed failed"
        int attempts_made
        string worker_id "current owner"
    }

    INGESTION_SCOPE {
        string scope_id PK
        string scope_kind "group | event"
        string retrieval_status "pending active stopped_inactive stopped_unknown retired"
        datetime event_ends_at "event scopes only"
        datetime first_observed_at "promotion order, shared ceiling"
    }

    INGESTION_SCOPE ||--o{ INGESTION_JOB : scopes
    INGESTION_SCOPE ||--o{ INGESTION_LEDGER : owns
    INGESTION_JOB ||--|| INGESTION_LEDGER : tracked_by
    PROCESSING_PERIOD ||--o{ INGESTION_JOB : schedules
    PROCESSING_PERIOD ||--o{ INGESTION_LEDGER : records