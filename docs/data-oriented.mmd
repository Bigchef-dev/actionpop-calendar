erDiagram
    direction TB

    %% =========================================================
    %% COUCHE 1 : RACINES & ORCHESTRATION (NIVEAU HAUT)
    %% =========================================================

    REDIS_STORE {
        string store_id PK
        string aof_mode "appendfsync everysec"
        string docker_volume "named persistent volume"
    }

    PROCESSING_PERIOD {
        string period_token PK "UTC slot identity"
        datetime period_start_utc
        datetime period_end_utc
    }

    GROUP_SCOPE {
        string scope_id PK "Action Populaire group id"
        string display_name
        boolean active "source is_active"
        string scope_type
        int source_subtype
        boolean certified
        string location_id FK
        string source_link
        string source_filter
    }

    REGION {
        string code_region PK
        string nom
    }

    EPCI {
        string id_epci PK
        string nom
        string type_epci "Métropole, CC..."
    }

    %% =========================================================
    %% COUCHE 2 : INTERMÉDIAIRES, JOBS & NIVEAUX DÉPARTEMENTAUX
    %% =========================================================

    CACHE_ENTRY {
        string cache_key PK
        string value_reference
        datetime expires_at
    }

    INGESTION_JOB {
        string job_id PK "deterministic scope-period id"
        string scope_id FK
        string period_token FK
        string status "waiting delayed active completed failed"
        int attempts_made
        string worker_id "current owner"
    }

    DEPARTEMENT {
        string code_departement PK
        string nom
        string code_region FK
    }

    %% =========================================================
    %% COUCHE 3 : TRAÇABILITÉ, ENTITÉS LOCALES & ADRESSES
    %% =========================================================

    INGESTION_LEDGER {
        string ledger_key PK "technical processing identity"
        string job_id FK
        string status "scheduled running publishing succeeded retrying failed"
        datetime last_completed_at
    }

    LOCATION_RECORD {
        string location_id PK "location event/group id"
        string owner_type "EVENT or GROUP"
        string name
        string address1
        string address2
        string zip
        string city
        string full_address
        string short_address
        string static_map_url
    }

    GEO_POINT {
        string location_id PK, FK
        string type "Point"
        decimal longitude "-180..180"
        decimal latitude "-90..90"
    }

    CIRCONSCRIPTION {
        string id_circo PK
        int numero
        string nom
        string code_departement FK
    }

    COMMUNE {
        string code_insee PK
        string nom
        string code_postal
        string id_epci FK
        string code_departement FK
    }

    %% =========================================================
    %% COUCHE 4 : L'ÉVÉNEMENT (AGRÉGAT CENTRAL) & ARRONDISSEMENTS
    %% =========================================================

    ARRONDISSEMENT {
        string code_insee_ar PK
        string nom
        string code_insee_commune FK
    }

    EVENT_RECORD {
        string source_event_id PK
        string content_hash
        int sequence
        string status "ACTIVE CANCELLED"
        datetime start_time
        datetime end_time
        string event_type "tractage, boitage, etc."
        string timezone "Europe/Paris"
        string summary
        string location_id FK
        string code_insee FK "Lien vers la COMMUNE"
        string source_url
        string last_seen_period FK
        datetime updated_at
    }

    %% =========================================================
    %% COUCHE 5 : TABLES DE LIAISON (PIVOTS N:M, NIVEAU BAS)
    %% =========================================================

    EVENT_GROUP_LINK {
        string event_id PK, FK
        string scope_id PK, FK
    }

    EVENT_CIRCO_LINK {
        string event_id PK, FK
        string id_circo PK, FK
    }

    EVENT_ARRONDISSEMENT_LINK {
        string event_id PK, FK
        string code_insee_ar PK, FK
    }

    %% =========================================================
    %% RELATIONS (FLUX DESCENDANT STRICT PARENT -> ENFANT)
    %% =========================================================

    %% 1. Pipeline Ingestion & Cache (Gauche)
    REDIS_STORE ||--o{ CACHE_ENTRY : stores
    PROCESSING_PERIOD ||--o{ INGESTION_JOB : schedules
    PROCESSING_PERIOD ||--o{ INGESTION_LEDGER : records
    GROUP_SCOPE ||--o{ INGESTION_JOB : scopes
    GROUP_SCOPE ||--o{ INGESTION_LEDGER : owns
    INGESTION_JOB ||--|| INGESTION_LEDGER : tracked_by

    %% 2. Adresses & Géolocalisation brute (Centre-Gauche)
    GROUP_SCOPE ||--|| LOCATION_RECORD : group_location
    LOCATION_RECORD ||--o| GEO_POINT : coordinates
    EVENT_RECORD ||--|| LOCATION_RECORD : event_location

    %% 3. Référentiel Administratif (Droite)
    REGION ||--o{ DEPARTEMENT : composes
    DEPARTEMENT ||--|{ CIRCONSCRIPTION : is_split_into
    DEPARTEMENT ||--o{ COMMUNE : contains
    EPCI ||--o{ COMMUNE : groups
    COMMUNE ||--o{ ARRONDISSEMENT : divides

    %% 4. Rattachement de l'Événement (Centre)
    PROCESSING_PERIOD ||--o{ EVENT_RECORD : last_seen
    COMMUNE ||--o{ EVENT_RECORD : hosts

    %% 5. Tables de Liaison N:M (Bas du diagramme)
    GROUP_SCOPE ||--|{ EVENT_GROUP_LINK : organizes
    EVENT_RECORD ||--|{ EVENT_GROUP_LINK : belongs_to

    CIRCONSCRIPTION ||--|{ EVENT_CIRCO_LINK : includes
    EVENT_RECORD ||--|{ EVENT_CIRCO_LINK : covers

    ARRONDISSEMENT ||--|{ EVENT_ARRONDISSEMENT_LINK : includes
    EVENT_RECORD ||--o{ EVENT_ARRONDISSEMENT_LINK : covers