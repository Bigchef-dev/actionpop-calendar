erDiagram
    direction TB

    %% =========================================================
    %% COUCHE 1 : RACINES & ORCHESTRATION (NIVEAU HAUT)
    %% =========================================================

    PROCESSING_PERIOD {
        string period_token PK "UTC slot identity"
        datetime period_start_utc
        datetime period_end_utc
    }

    INGESTION_SCOPE {
        string scope_id PK "group id, or event id for an event scope"
        string scope_key "lower(trim(scope_id))"
        string scope_kind "group | event"
        string display_name
        string discovery_source "directory | event_payload"
        string map_status "listed inactive unlisted removed not_applicable"
        string retrieval_status "pending active stopped_inactive stopped_unknown retired"
        datetime event_ends_at "event scopes only"
        string scope_type "group only"
        int source_subtype "group only"
        boolean certified "group only"
        string location_id FK "group only"
        string source_link "group only"
        string source_filter "group only"
    }

    %% =========================================================
    %% COUCHE 2 : INTERMÉDIAIRES, JOBS & NIVEAUX DÉPARTEMENTAUX
    %% =========================================================

    DEPARTEMENT {
        string code_departement PK
        string nom
        string code_region FK
    }

    %% =========================================================
    %% COUCHE 3 : TRAÇABILITÉ, ENTITÉS LOCALES & ADRESSES
    %% =========================================================



    LOCATION_RECORD {
        string location_id PK "location event/group id"
        string owner_type "EVENT or GROUP"
        string name
        string address1
        string address2
        string zip
        string city
        string full_address
        string short_address
        string static_map_url
    }

    GEO_POINT {
        string location_id PK, FK
        string type "Point"
        decimal longitude "-180..180"
        decimal latitude "-90..90"
    }

    COMMUNE {
        string code_insee PK
        string nom
        string code_postal
        string id_epci FK
        string code_departement FK
    }

    %% =========================================================
    %% COUCHE 4 : L'ÉVÉNEMENT (AGRÉGAT CENTRAL)
    %% =========================================================

    EVENT_RECORD {
        string source_event_id PK
        string content_hash
        int sequence
        string status "ACTIVE CANCELLED"
        datetime start_time
        datetime end_time
        string event_type "tractage, boitage, etc."
        string timezone "Europe/Paris"
        string summary
        string location_id FK
        string code_insee FK "Lien vers la COMMUNE"
        string source_url
        string last_seen_period FK
        datetime updated_at
    }

    %% =========================================================
    %% COUCHE 5 : TABLES DE LIAISON (PIVOTS N:M, NIVEAU BAS)
    %% =========================================================

    EVENT_GROUP_LINK {
        string event_id PK, FK
        string scope_id PK, FK
    }

    EVENT_CIRCO_LINK {
        string event_id PK, FK
        string id_circo PK, FK
    }

    EVENT_ARRONDISSEMENT_LINK {
        string event_id PK, FK
        string code_insee_ar PK, FK
    }

    %% =========================================================
    %% RELATIONS (FLUX DESCENDANT STRICT PARENT -> ENFANT)
    %% =========================================================

    %% 1. Pipeline Ingestion & Cache (Gauche)


    %% 2. Adresses & Géolocalisation brute (Centre-Gauche)
    INGESTION_SCOPE |o--o| LOCATION_RECORD : group_location
    LOCATION_RECORD ||--o| GEO_POINT : coordinates
    EVENT_RECORD ||--|| LOCATION_RECORD : event_location

    %% 3. Référentiel Administratif (Droite)
    REGION ||--o{ DEPARTEMENT : composes
    DEPARTEMENT ||--o{ COMMUNE : contains
    COMMUNE ||--o{ ARRONDISSEMENT : divides

    %% 4. Rattachement de l'Événement (Centre)
    PROCESSING_PERIOD ||--o{ EVENT_RECORD : last_seen
    COMMUNE ||--o{ EVENT_RECORD : hosts

    %% 5. Tables de Liaison N:M (Bas du diagramme)
    INGESTION_SCOPE ||--o{ EVENT_GROUP_LINK : organizes
    EVENT_RECORD ||--|{ EVENT_GROUP_LINK : belongs_to