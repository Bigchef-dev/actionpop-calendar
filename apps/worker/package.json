{
  "name": "@actionpop/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@actionpop/core": "workspace:*",
    "bullmq": "^6.5.2",
    "ioredis": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "typecheck": "tsc -b --pretty false --force",
    "test": "vitest run",
    "lint": "eslint src tests",
    "quality": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
